// Prisma schema — App de control de horas para construcción
// Basado en el modelo de datos del Análisis de Requisitos

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  ADMIN
  SUPERVISOR
  EMPLOYEE
  BOOKKEEPER
}

enum TimeEntryType {
  AUTO
  MANUAL
  DELEGATED
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  payCycle   String   @default("weekly") // weekly | biweekly | monthly
  createdAt  DateTime @default(now())

  users      User[]
  crews      Crew[]
  projects   Project[]
  payPeriods PayPeriod[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  crewId         String?
  crew           Crew?    @relation(fields: [crewId], references: [id])
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(EMPLOYEE)
  createdAt      DateTime @default(now())

  timeEntries      TimeEntry[] @relation("EntryOwner")
  editedEntries    TimeEntry[] @relation("EntryEditor")
  schedules        Schedule[]
}

model Crew {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String

  members        User[]
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(120) // metros
  budgetHours    Float?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  timeEntries    TimeEntry[]
  tasks          Task[]
  schedules      Schedule[]
}

model TimeEntry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation("EntryOwner", fields: [userId], references: [id])
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  type        TimeEntryType @default(AUTO)
  clockIn     DateTime
  clockOut    DateTime?
  editedById  String?
  editedBy    User?         @relation("EntryEditor", fields: [editedById], references: [id])
  editedAt    DateTime?

  breaks      Break[]
}

model Break {
  id          String    @id @default(uuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id])
  start       DateTime
  end         DateTime?
}

model Task {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  title     String
  status    String  @default("pending") // pending | in_progress | done
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  startTime DateTime
  endTime   DateTime
}

model PayPeriod {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  frequency      String   // weekly | biweekly | monthly
  startDate      DateTime
}
