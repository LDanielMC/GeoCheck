// Prisma schema — GeoCheck (control de horas por geofencing para construcción)
// Rebanada 0: base multi-tenant (organizaciones, usuarios con rol, invitaciones)
// más el mínimo de Project y TimeEntry que ya usa el código.
// Crew, Break, Task, Schedule y PayPeriod vuelven con la rebanada que los necesite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase: cadena con pooler (?pgbouncer=true)
  directUrl = env("DIRECT_URL") // conexión directa; la usan las migraciones
}

enum UserRole {
  ADMIN
  SUPERVISOR
  EMPLOYEE
  BOOKKEEPER
}

enum TimeEntryType {
  AUTO
  MANUAL
  DELEGATED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  invitations Invitation[]
  projects    Project[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique // siempre en minúsculas (la API lo normaliza)
  passwordHash   String
  role           UserRole     @default(EMPLOYEE)
  invitationId   String? // con qué invitación se unió (null si creó la organización)
  invitation     Invitation?  @relation("InvitationJoined", fields: [invitationId], references: [id])
  createdAt      DateTime     @default(now())

  invitationsCreated Invitation[] @relation("InvitationCreator")
  timeEntries        TimeEntry[]  @relation("EntryOwner")
  editedEntries      TimeEntry[]  @relation("EntryEditor")

  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String       @unique // 8 caracteres sin I/L/O/0/1, fácil de dictar
  role           UserRole     @default(EMPLOYEE) // la API nunca permite ADMIN
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdBy      User         @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  users User[] @relation("InvitationJoined")

  @@index([organizationId])
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  latitude       Float
  longitude      Float
  geofenceRadius Int          @default(150) // metros; la API limita a 100–1000 (ver docs/spike-resultado.md)
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  timeEntries TimeEntry[]

  @@index([organizationId, archived])
}

model TimeEntry {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation("EntryOwner", fields: [userId], references: [id])
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  type       TimeEntryType @default(AUTO)
  clockIn    DateTime
  clockOut   DateTime?
  editedById String?
  editedBy   User?         @relation("EntryEditor", fields: [editedById], references: [id])
  editedAt   DateTime?

  @@index([userId, clockIn])
  @@index([projectId, clockIn])
  // Además, en el SQL de la migración (Prisma no expresa índices parciales):
  //   CREATE UNIQUE INDEX "TimeEntry_one_open_per_user" ON "TimeEntry"("userId") WHERE "clockOut" IS NULL;
}
