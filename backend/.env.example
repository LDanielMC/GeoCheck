# --- Base de datos -----------------------------------------------------------
# Local (Docker): docker compose up -d
DATABASE_URL=postgresql://geocheck:geocheck@localhost:5432/geocheck
DIRECT_URL=postgresql://geocheck:geocheck@localhost:5432/geocheck

# Supabase (Project Settings > Database > Connect). Reemplaza las dos de arriba:
#   DATABASE_URL = Transaction pooler (puerto 6543) con ?pgbouncer=true   -> la usa la app
#   DIRECT_URL   = Session pooler (puerto 5432) o conexión directa        -> la usa `prisma migrate`
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Servidor ------------------------------------------------------------------
# Mínimo 32 caracteres. Este valor sirve solo para desarrollo: con NODE_ENV=production se rechaza.
# Genera uno real con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789
PORT=3000

# Detrás de un proxy (Railway, Render, Fly...) indica cuántos hay para que el rate limit vea la IP real.
# TRUST_PROXY=1

# Intentos por minuto y por IP en registro, login y unirse con código.
# AUTH_RATE_LIMIT_MAX=10
