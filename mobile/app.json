{
  "expo": {
    "name": "GeoCheck",
    "slug": "geocheck",
    "version": "0.1.0",
    "scheme": "geocheck",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cliche.geocheck",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cliche.geocheck",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GeoCheck usa tu ubicación para registrar tus horas automáticamente cuando llegas y sales de la obra, incluso con la app cerrada.",
          "locationAlwaysPermission": "GeoCheck usa tu ubicación para registrar tus horas automáticamente cuando llegas y sales de la obra, incluso con la app cerrada.",
          "locationWhenInUsePermission": "GeoCheck usa tu ubicación para saber si estás dentro de la obra.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E6B3C"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/public-sans/400Regular/PublicSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/public-sans/500Medium/PublicSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/public-sans/600SemiBold/PublicSans_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/public-sans/700Bold/PublicSans_700Bold.ttf"
          ]
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f18e1210-9cc0-4ab5-a0ec-8d7c00d69302"
      }
    },
    "owner": "danielmcam"
  }
}
